# Copiar a .env y completar. Nunca subir .env al repositorio.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5

# Conexión al ERP con un usuario de SOLO LECTURA.
# Por defecto usa la base de demostración (backend/demo_erp.db).
# Ejemplos:
# ERP_URL=mssql+pyodbc://lector:clave@servidor/TANGO?driver=ODBC+Driver+18+for+SQL+Server
# ERP_URL=postgresql+psycopg://lector:clave@servidor:5432/odoo
# ERP_URL=sqlite:///demo_erp.db

MAX_FILAS=200
MAX_VUELTAS_HERRAMIENTAS=8

# Claves del Centro de pruebas (solo roles operador y tester). Cambialas antes de publicar la plataforma.
CLAVE_U4=operador-demo
CLAVE_U5=tester-demo

# Retail (comercios): base PostgreSQL propia con aislamiento por empresa (RLS).
# En Codespaces la crea sola tools/codespaces/postgres.sh. El usuario NO puede ser superusuario.
# RETAIL_DB_URL=postgresql://retail_app:CLAVE@localhost:5433/retail
# Retail · panel para distribuidores: mínimo de comercios por grupo y participación máxima de uno solo (anonimato).
PANEL_MIN_COMERCIOS=5
PANEL_MAX_PARTICIPACION=0.6
