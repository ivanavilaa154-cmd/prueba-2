# Copiar a .env y completar. Nunca subir .env al repositorio.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5

# Conexión al ERP con un usuario de SOLO LECTURA.
# Por defecto usa la base de demostración (backend/demo_erp.db).
# Ejemplos:
# ERP_URL=mssql+pyodbc://lector:clave@servidor/TANGO?driver=ODBC+Driver+18+for+SQL+Server
# ERP_URL=postgresql+psycopg://lector:clave@servidor:5432/odoo
# ERP_URL=sqlite:///demo_erp.db

MAX_FILAS=200
MAX_VUELTAS_HERRAMIENTAS=8
